exports[`today's phone menu, open the panel of the open menu is the one the header drew before the sheet menu existed, signed out 1`] = `"<div class="lg:hidden overflow-hidden border-t border-[var(--accent)]/10 bg-[var(--cream)]" style="height:0px;opacity:0"><div class="px-6 py-4"><div class="flex flex-col gap-1"><div><button class="flex items-center justify-between w-full px-4 py-3 text-sm font-semibold text-[var(--foreground)] hover:text-[var(--accent)] hover:bg-[var(--accent)]/5 rounded-xl transition-colors" aria-expanded="false">Product<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="w-4 h-4 transition-transform duration-200 "><path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"></path></svg></button></div><a class="px-4 py-3 text-sm font-semibold rounded-xl transition-colors text-[var(--foreground)] hover:text-[var(--accent)] hover:bg-[var(--accent)]/5" href="/en/loyalty-programs">Loyalty</a><a class="px-4 py-3 text-sm font-semibold rounded-xl transition-colors text-[var(--foreground)] hover:text-[var(--accent)] hover:bg-[var(--accent)]/5" href="/en/pricing">Pricing</a><a class="px-4 py-3 text-sm font-semibold rounded-xl transition-colors text-[var(--foreground)] hover:text-[var(--accent)] hover:bg-[var(--accent)]/5" href="/en/blog">Blog</a><a class="px-4 py-3 text-sm font-semibold rounded-xl transition-colors text-[var(--foreground)] hover:text-[var(--accent)] hover:bg-[var(--accent)]/5" href="/en/changelog">What&#x27;s new</a><a class="px-4 py-3 text-sm font-semibold rounded-xl transition-colors text-[var(--foreground)] hover:text-[var(--accent)] hover:bg-[var(--accent)]/5" href="/en/about">About</a><a class="px-4 py-3 text-sm font-semibold rounded-xl transition-colors text-[var(--foreground)] hover:text-[var(--accent)] hover:bg-[var(--accent)]/5" href="/en/contact">Contact</a><div class="flex items-center justify-between pt-4 mt-2 border-t border-[var(--accent)]/10"><div class="relative" style="width:46px;height:34px"><div role="group" aria-label="Change language" class="absolute overflow-hidden z-40 left-0 top-0 rounded-lg border border-[var(--border)] bg-[var(--cream)]" style="height:34px;width:46px;transition:width 400ms cubic-bezier(0.22, 1, 0.36, 1), height 400ms cubic-bezier(0.22, 1, 0.36, 1)"><div class="absolute left-0 top-0 flex flex-row" style="transform:translate(0px, 0px)"><button type="button" aria-current="true" aria-label="Current language: EN" style="width:46px;height:34px;transition:color 150ms ease, background-color 150ms ease" class="flex shrink-0 items-center justify-center text-xs font-bold uppercase select-none text-[var(--foreground)] hover:bg-[var(--muted)]">EN</button><button type="button" aria-label="Switch to FR" style="width:46px;height:34px;transition:color 150ms ease, background-color 150ms ease" class="flex shrink-0 items-center justify-center text-xs font-bold uppercase select-none text-[var(--foreground)] hover:bg-[var(--muted)]">FR</button><button type="button" aria-label="Switch to ES" style="width:46px;height:34px;transition:color 150ms ease, background-color 150ms ease" class="flex shrink-0 items-center justify-center text-xs font-bold uppercase select-none text-[var(--foreground)] hover:bg-[var(--muted)]">ES</button><button type="button" aria-label="Switch to PL" style="width:46px;height:34px;transition:color 150ms ease, background-color 150ms ease" class="flex shrink-0 items-center justify-center text-xs font-bold uppercase select-none text-[var(--foreground)] hover:bg-[var(--muted)]">PL</button></div></div></div></div><div class="flex flex-col gap-2"><a class="px-4 py-3 text-sm font-semibold text-[var(--foreground)] hover:text-[var(--accent)] transition-colors" href="/en/login">Log in</a><a class="flex items-center justify-center h-12 px-5 bg-[var(--accent)] text-white text-sm font-bold rounded-xl hover:brightness-110 transition-all" href="/en/onboarding">Get started  →</a></div></div></div></div>"`;

