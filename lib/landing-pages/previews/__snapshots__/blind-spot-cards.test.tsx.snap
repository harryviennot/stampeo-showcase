exports[`the cards with no props: the live page's own the six questions, each over its ???, under the section's title and description 1`] = `"<section class="py-16 sm:py-24 bg-[var(--blog-bg)]"><div class="mx-auto max-w-[1360px] px-4 sm:px-6 lg:px-8 "><div data-sr="true" class="scroll-reveal max-w-3xl mx-auto text-center mb-12"><h2 class="text-h2 text-[var(--foreground)] mb-4">What you don&#x27;t know today</h2><p class="text-lead text-[var(--muted-foreground)] leading-relaxed">With paper cards, you&#x27;re managing loyalty blind. No data, no visibility, no way to improve what you can&#x27;t measure.</p></div><div data-sr="true" class="scroll-reveal-stagger "><div class="grid grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6" style="perspective:1000px"><div class="relative cursor-pointer" style="perspective:1000px"><div class="relative w-full" style="transform-style:preserve-3d"><div class="blog-card-3d rounded-2xl bg-white p-6 sm:p-8 flex flex-col items-center justify-center text-center min-h-[160px] sm:min-h-[180px]" style="backface-visibility:hidden"><span class="text-4xl sm:text-5xl font-bold text-[var(--muted-foreground)]/20 mb-3">?</span><p class="text-sm sm:text-base font-semibold text-[var(--foreground)] leading-snug">How many regular customers</p></div><div class="blog-card-3d rounded-2xl bg-[var(--blog-bg-alt)] p-6 sm:p-8 flex flex-col items-center justify-center text-center min-h-[160px] sm:min-h-[180px] absolute inset-0" style="backface-visibility:hidden;transform:rotateY(180deg)"><span class="text-3xl mb-2">🤷</span><p class="text-xl font-bold text-[var(--muted-foreground)]">???</p></div></div></div><div class="relative cursor-pointer" style="perspective:1000px"><div class="relative w-full" style="transform-style:preserve-3d"><div class="blog-card-3d rounded-2xl bg-white p-6 sm:p-8 flex flex-col items-center justify-center text-center min-h-[160px] sm:min-h-[180px]" style="backface-visibility:hidden"><span class="text-4xl sm:text-5xl font-bold text-[var(--muted-