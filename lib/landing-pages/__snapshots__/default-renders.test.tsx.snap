nded-full flex items-center justify-center text-xs font-bold shrink-0" style="background:var(--accent);color:#fff">2</span><span class="text-sm font-medium text-[var(--foreground)]">Name</span></div><div class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-white border border-[var(--accent)]/10" style="opacity:0;transform:translateY(10px)"><span class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold shrink-0" style="background:var(--accent);color:#fff">3</span><span class="text-sm font-medium text-[var(--foreground)]">Stamps</span></div><div class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-white border border-[var(--accent)]/10" style="opacity:0;transform:translateY(10px)"><span class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold shrink-0" style="background:var(--accent);color:#fff">4</span><span class="text-sm font-medium text-[var(--foreground)]">Fields</span></div><div class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-white border border-[var(--accent)]/10" style="opacity:0;transform:translateY(10px)"><span class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold shrink-0" style="background:var(--accent);color:#fff">5</span><span class="text-sm font-medium text-[var(--foreground)]">Reward</span></div><div class="flex items-center gap-2.5 px-3 py-2 rounded-xl bg-white border border-[var(--accent)]/10" style="opacity:0;transform:translateY(10px)"><span class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold shrink-0" style="background:var(--accent);color:#fff">6</span><span class="text-sm font-medium text-[var(--foreground)]">QR code</span></div></div></div></div></div></section>"
`;

exports[`what a component renders when a page's new props are left out (AC15) IconLibrarySection: the section with its heading and the two marquee rows 1`] = `"<section class="py-16 sm:py-24 bg-[var(--blog-bg)] overflow-hidden"><div class="mx-auto max-w-[1360px] px-4 sm:px-6 lg:px-8 "><div data-sr="true" class="scroll-reveal max-w-3xl mx-auto text-center mb-12"><h2 class="text-h2 text-[var(--foreground)] mb-4">An icon for every trade</h2><p class="text-lead text-[var(--muted-foreground)] leading-relaxed">98 ready-to-use stamp icons across 8 categories, searchable by name in the editor. Café, salon, retail: one fits your business, guaranteed.</p></div></div><div data-sr="true" class="scroll-reveal "><div class="relative"><div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 sm:w-32 bg-gradient-to-r from-[var(--blog-bg)] to-transparent"></div><div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 sm:w-32 bg-gradient-to-l from-[var(--blog-bg)] to-transparent"></div><div class="overflow-hidden"><div class="flex w-max gap-3 py-1.5 will-change-transform" style="animation:marquee-scroll 70s linear infinite"><div class="flex h-12 w-12 sm:h-14 sm:w-14 shrink-0 items-center justify-center rounded-2xl shadow-sm" style="background-color:#F97316"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="w-6 h-6" style="color:#ffffff"><path d="M208,80H32a8,8,0,0,0-8,8v48a96.3,96.3,0,0,0,32.54,72H32a8,8,0,0,0,0,16H208a8,8,0,0,0,0-16H183.46a96.59,96.59,0,0,0,27-40.09A40,40,0,0,0,248,128v-8A40,40,0,0,0,208,80Zm24,48a24,24,0,0,1-17.2,23,95.78,95.78,0,0,0,1.2-15V97.38A24,24,0,0,1,232,120ZM112,56V24a8,8,0,0,1,16,0V56a8,8,0,0,1-16,0Zm32,0V24a8,8,0,0,1,16,0V56a8,8,0,0,1-16,0ZM80,56V24a8,8,0,0,1,16,0V56a8,8,0,0,1-16,0Z"></path></svg></div><div class="flex h-12 w-12 sm:h-14 sm:w-14 shrink-0 items-center justify-center rounded-2xl shadow-sm" style="background-color:#0B1B2B"><svg xmlns="http://www.w3.org/2000