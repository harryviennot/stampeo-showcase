exports[`what a component renders when a page's new props are left out (AC15) LiveActivityFeed: the feed as a section with its heading 1`] = `"<section class="py-16 sm:py-24 bg-[var(--blog-bg)]"><div class="mx-auto max-w-[1360px] px-4 sm:px-6 lg:px-8 "><div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center"><div data-sr="true" class="scroll-reveal-left "><div class="blog-card-3d rounded-2xl bg-white overflow-hidden"><div class="flex items-center justify-between gap-2 px-5 py-3 border-b border-[var(--border)]"><span class="text-sm font-semibold text-[var(--foreground)]">Activity</span><span class="flex items-center gap-1.5 text-xs font-semibold text-[var(--accent)]"><span class="w-2 h-2 rounded-full bg-[var(--accent)] pulse-dot"></span>Live</span></div><div class="p-4 overflow-hidden" style="height:256px"></div></div></div><div data-sr="true" class="scroll-reveal-right " style="transition-delay:150ms"><h2 class="text-h2 text-[var(--foreground)] mb-4">Your business, in real time</h2><p class="text-lead text-[var(--muted-foreground)] leading-relaxed">Every stamp, every reward, every new card: follow your loyalty program as it happens.</p></div></div></div></section>"`;

