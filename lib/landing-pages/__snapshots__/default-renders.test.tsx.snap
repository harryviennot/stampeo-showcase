exports[`what Platform's own pieces render when the previews' new props are left out (AC2) ProgramTypeRows: every row open, the guide link under them 1`] = `"<div class="mx-auto max-w-[1200px]"><ol class="border-b border-[var(--border)]"><li data-key="stamps" data-open="true" class="relative border-t border-[var(--border)]"><div class="grid grid-cols-[128px_1fr] items-center gap-5 py-4 lg:grid-cols-[1fr_240px] lg:gap-12 lg:py-10 lg:pr-24 lg:pl-12"><div class="flex justify-center lg:order-2"><i>stamps card</i></div><div class="min-w-0 transition-transform duration-300 ease-out motion-reduce:transition-none "><div class="grid transition-[grid-template-rows,opacity] duration-300 ease-out motion-reduce:transition-none grid-rows-[1fr] opacity-100"><div class="overflow-hidden"><p class="pb-2 text-xs font-semibold uppercase tracking-[0.2em] sm:text-[13px] text-[var(--accent-hover)]">Reward every visit</p></div></div><h3 class="text-h2 lg:text-h1"><button type="button" aria-expanded="true" class="text-left after:absolute after:inset-0 after:rounded-2xl after:content-[&#x27;&#x27;] focus-visible:outline-none focus-visible:after:ring-2 focus-visible:after:ring-[var(--accent)]">Stamps</button></h3><div class="grid transition-[grid-template-rows,opacity] duration-300 ease-out motion-reduce:transition-none grid-rows-[1fr] opacity-100"><div class="overflow-hidden"><p class="mt-3 max-w-md text-pretty text-base text-[var(--muted-foreground)] lg:text-lg">Every visit adds a stamp, and a full card earns the reward. Staff can add several stamps in one scan.</p></div></div></div></div></li><li data-key="points" data-open="true" class="relative border-t border-[var(--border)]"><div class="grid grid-cols-[128px_1fr] items-center gap-5 py-4 lg:grid-cols-[1fr_240px] lg:gap-12 lg:py-10 lg:pr-24 lg:pl-12"><div class="flex justify-center lg:order-2"><i>points card</i></div><div class="min-w-0 transition-transform duration-300 ease-out motion-reduce:transition-none "><div class="grid transition-[grid-template-rows,opacity] duration-300 ease-out motion-reduce:transition-none grid-rows-[1fr] opacity-100"><div class="overflow-hidden"><p class="pb-2 text-xs font-semibold uppercase tracking-[0.2em] sm:text-[13px] text-[var(--accent-hover)]">Reward what they spend</p></div></div><h3 class="text-h2 lg:text-h1"><button type="button" aria-expanded="true" class="text-left after:absolute after:inset-0 after:rounded-2xl after:content-[&#x27;&#x27;] focus-visible:outline-none focus-visible:after:ring-2 focus-visible:after:ring-[var(--accent)]">Points</button></h3><div class="grid transition-[grid-template-rows,opacity] duration-300 ease-out motion-reduce:transition-none grid-rows-[1fr] opacity-100"><div class="overflow-hidden"><p class="mt-3 max-w-md text-pretty text-base text-[var(--muted-foreground)] lg:text-lg">Staff type in what they spent and the points add up. Customers pick from your reward menu, in any order.</p></div></div></div></div></li><li data-key="levels" data-open="true" class="relative border-t border-[var(--border)]"><div class="grid grid-cols-[128px_1fr] items-center gap-5 py-4 lg:grid-cols-[1fr_240px] lg:gap-12 lg:py-10 lg:pr-24 lg:pl-12"><div class="flex justify-center lg:order-2"><i>levels cards</i></div><div class="min-w-0 transition-transform duration-300 ease-out motion-reduce:transition-none "><div class="grid transition-[grid-template-rows,opacity] duration-300 ease-out motion-reduce:transition-none grid-rows-[1fr] opacity-100"><div class="overflow-hidden"><p class="pb-2 text-xs font-semibold uppercase tracking-[0.2em] sm:text-[13px] text-[var(--accent-hover)]">Reward regulars more</p></div></div><h3 class="text-h2 lg:text-h1"><button type="button" aria-expanded="true" class="text-left after:absolute after:inset-0 after:rounded-2xl after:content-[&#x27;&#x27;] focus-visible:outline-none focus-visible:after:ring-2 focus-visible:after:ring-[var(--accent)]">Levels</button></h3><div class="grid transition-[grid-template-rows,opacity] duration-300 ease-out motion-reduce:transition-none grid-rows-[1fr] opacity-100"><div class="overflow-hidden"><p class="mt-3 max-w-md text-pretty text-base text-[var(--muted-foreground)] lg:text-lg">Up to 5 levels, like Bronze, Silver and Gold. Customers move up as they keep coming back, and their card takes on a new look.</p></div></div></div></div></li></ol><a class="mt-6 flex min-h-14 w-full items-center justify-center gap-2 rounded-2xl border border-[var(--border)] bg-white/60 px-4 py-3 text-center text-sm font-semibold text-[var(--foreground)] transition-colors hover:bg-white lg:min-h-[72px] lg:tracking-[0.12em] lg:uppercase" href="/en/loyalty-programs">How to choose between stamps and points<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M224.49,136.49l-72,72a12,12,0,0,1-17-17L187,140H40a12,12,0,0,1,0-24H187L135.51,64.48a12,12,0,0,1,17-17l72,72A12,12,0,0,1,224.49,136.49Z"></path></svg></a></div>"`;
