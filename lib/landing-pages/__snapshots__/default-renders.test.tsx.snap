exports[`what a component renders when a page's new props are left out (AC15) FAQList: the inked cards, the first one open, as the card design and broadcasts pages use it 1`] = `"<div class="flex flex-col gap-5"><details class="group flex flex-col rounded-xl bg-white blog-card-3d px-6 py-4" open=""><summary class="flex cursor-pointer items-center justify-between gap-6 py-2 list-none"><p class="text-lg font-bold leading-normal group-hover:text-[var(--accent)] transition-colors">Can I use my own stamp icons?</p><div class="text-[var(--muted-foreground)] transition-transform duration-300 group-open:rotate-180 group-open:text-[var(--accent)]"><span class="text-xl font-bold">↓</span></div></summary><div class="pt-2 pb-4"><p class="text-[var(--muted-foreground)] text-base font-medium leading-relaxed">Yes, import any image.</p></div></details><details class="group flex flex-col rounded-xl bg-white blog-card-3d px-6 py-4"><summary class="flex cursor-pointer items-center justify-between gap-6 py-2 list-none"><p class="text-lg font-bold leading-normal group-hover:text-[var(--accent)] transition-colors">Can I change the style later?</p><div class="text-[var(--muted-foreground)] transition-transform duration-300 group-open:rotate-180 group-open:text-[var(--accent)]"><span class="text-xl font-bold">↓</span></div></summary><div class="pt-2 pb-4"><p class="text-[var(--muted-foreground)] text-base font-medium leading-relaxed">Anytime.</p></div></details></div>"`;

exports[`what a component renders when a page's new props are left out (AC15) FAQList: every card closed, as the homepage variant and the comparison pages use it 1`] = `"<div class="flex flex-col gap-5"><details class="group flex flex-col rounded-xl bg-white blog-card-3d px-6 py-4"><summary class="flex cursor-pointer items-center justify-between gap-6 py-2 list-none"><p class="text-lg font-bold leading-normal group-hover:text-[var(--accent)] transition-colors">Can I use my own stamp icons?</p><div class="text-[var(--muted-foreground)] transition-transform duration-300 group-open:rotate-180 group-open:text-[var(--accent)]"><span class="text-xl font-bold">↓</span></div></summary><div class="pt-2 pb-4"><p class="text-[var(--muted-foreground)] text-base font-medium leading-relaxed">Yes, import any image.</p></div></details><details class="group flex flex-col rounded-xl bg-white blog-card-3d px-6 py-4"><summary class="flex cursor-pointer items-center justify-between gap-6 py-2 list-none"><p class="text-lg font-bold leading-normal group-hover:text-[var(--accent)] transition-colors">Can I change the style later?</p><div class="text-[var(--muted-foreground)] transition-transform duration-300 group-open:rotate-180 group-open:text-[var(--accent)]"><span class="text-xl font-bold">↓</span></div></summary><div class="pt-2 pb-4"><p class="text-[var(--muted-foreground)] text-base font-medium leading-relaxed">Anytime.</p></div></details></div>"`;

exports[`what Platform's own pieces render when the previews' new props are left out (AC2) LpCtaPair: the trial, and Try it on your phone as an anchor to #demo 1`] = `"<div class="flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row sm:justify-center sm:gap-4"><a class="group inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-all h-[52px] px-7 text-base bg-[var(--accent)] text-white shadow-md shadow-[var(--accent)]/20 hover:brightness-105 keycap mb-[3px] w-full sm:mb-0 sm:w-auto" href="/en/onboarding"><span>Start my free trial</span><span class="transition-transform group-hover:translate-x-1">→</span></a><a href="#demo" class="keycap keycap-flat inline-flex h-[52px] w-full items-center justify-center gap-2 rounded-full border-[1.5px] border-[var(--near-black)] bg-white px-7 text-base font-semibold text-[var(--foreground)] sm:w-auto">Try it on your phone<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M216.49,104.49l-80,80a12,12,0,0,1-17,0l-80-80a12,12,0,0,1,17-17L128,159l71.51-71.52a12,12,0,0,1,17,17Z"></path></svg></a></div>"`;

exports[`what Platform's own pieces render when the previews' new props are left out (AC2) LpAccentBand: the cream card with Platform's headline 1`] = `"<div data-landing-section="final_cta"><section class="py-8 lg:py-16"><div class="mx-auto max-w-[1360px] px-4 sm:px-6 lg:px-8 "><div data-sr="true" class="scroll-reveal "><div class="relative isolate overflow-hidden rounded-[28px] bg-[var(--blog-bg)] px-6 py-14 text-center ring-1 ring-[var(--accent)]/15 sm:px-12 lg:py-20"><div aria-hidden="true" class="absolute inset-0 -z-10 rounded-[inherit] [background:radial-gradient(70%_90%_at_0%_0%,rgb(249_115_22/0.13),transparent_70%),radial-gradient(70%_90%_at_100%_100%,rgb(249_115_22/0.11),transparent_70%)] shadow-[inset_0_0_80px_rgb(249_115_22/0.07)]"></div><div class="flex flex-col items-center gap-5"><h2 class="text-display max-w-[840px] text-balance">Launch your loyalty card <span class="text-[var(--accent)]">today.</span></h2><p class="max-w-xl text-pretty text-lead text-[var(--muted-foreground)]">Design it, test it on your own phone, then choose a plan.</p><a class="group inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-all h-[52px] px-7 text-base bg-[var(--accent)] text-white shadow-md shadow-[var(--accent)]/20 hover:brightness-105 keycap mt-2 mb-[3px] w-full sm:w-auto" href="/en/onboarding"><span>Start my free trial</span><span class="transition-transform group-hover:translate-x-1">→</span></a><p class="text-sm font-medium text-[var(--muted-foreground)]"><span>14 days free · Cancel anytime</span></p></div></div></div></div></section></div>"`;

exports[`what Platform's own pieces render when the previews' new props are left out (AC2) NumberFigures: the handwritten figures, with no source line 1`] = `"<ul class="grid gap-8 text-center sm:grid-cols-3 sm:gap-6"><li class="flex flex-col items-center"><p class="ink-figure whitespace-nowrap" style="font-size:clamp(3.5rem, 2.2rem + 4vw, 6rem);transform:rotate(-2deg)">120+</p><p class="mt-2 text-lead text-[var(--muted-foreground)] sm:mt-3">businesses</p></li><li class="flex flex-col items-center"><p class="ink-figure whitespace-nowrap" style="font-size:clamp(3.5rem, 2.2rem + 4vw, 6rem);transform:rotate(1.5deg)">25+</p><p class="mt-2 text-lead text-[var(--muted-foreground)] sm:mt-3">countries</p></li><li class="flex flex-col items-center"><p class="ink-figure whitespace-nowrap" style="font-size:clamp(3.5rem, 2.2rem + 4vw, 6rem);transform:rotate(-1deg)">4</p><p class="mt-2 text-lead text-[var(--muted-foreground)] sm:mt-3">languages</p></li></ul>"`;

