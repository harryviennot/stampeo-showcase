white-space:nowrap">240</span></div><div style="position:absolute;left:92.88888888888889cqw;top:22.666666666666668cqw;transform:translate(-50%, -50%)"><div style="width:8.177777777777777cqw;height:8.177777777777777cqw;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#F4F2EE;border:0.5333333333333333cqw solid #faa687"><div style="width:4.497777777777777cqw;height:4.497777777777777cqw;display:flex"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" fill="currentColor" viewBox="0 0 256 256" class="w-full h-full" style="color:#faa687"><path d="M216,72H180.92c.39-.33.79-.65,1.17-1A29.53,29.53,0,0,0,192,49.57,32.62,32.62,0,0,0,158.44,16,29.53,29.53,0,0,0,137,25.91a54.94,54.94,0,0,0-9,14.48,54.94,54.94,0,0,0-9-14.48A29.53,29.53,0,0,0,97.56,16,32.62,32.62,0,0,0,64,49.57,29.53,29.53,0,0,0,73.91,71c.38.33.78.65,1.17,1H40A16,16,0,0,0,24,88v32a16,16,0,0,0,16,16v64a16,16,0,0,0,16,16h60a4,4,0,0,0,4-4V120H40V88h80v32h16V88h80v32H136v92a4,4,0,0,0,4,4h60a16,16,0,0,0,16-16V136a16,16,0,0,0,16-16V88A16,16,0,0,0,216,72ZM84.51,59a13.69,13.69,0,0,1-4.5-10A16.62,16.62,0,0,1,96.59,32h.49a13.69,13.69,0,0,1,10,4.5c8.39,9.48,11.35,25.2,12.39,34.92C109.71,70.39,94,67.43,84.51,59Zm87,0c-9.49,8.4-25.24,11.36-35,12.4C137.7,60.89,141,45.5,149,36.51a13.69,13.69,0,0,1,10-4.5h.49A16.62,16.62,0,0,1,176,49.08,13.69,13.69,0,0,1,171.49,59Z"></path></svg></div></div><span style="position:absolute;top:9.422222222222222cqw;left:50%;transform:translateX(-50%);color:#faa687;font-weight:700;font-size:3.911111111111111cqw;font-variant-numeric:tabular-nums;white-space:nowrap">480</span></div></div></div></div></div></div><div class="absolute inset-0 rounded-2xl pointer-events-none z-30" style="box-shadow:inset 0 0 0 1px rgba(0,0,0,0.1)"></div></div></div></div></div></div></div></div></div></div></div></div><div class="mx-auto max-w-[1360px] px-4 sm:px-6 lg:px-8 relative z-10 mt-5 lg:-mt-8 xl:mt-0"><div class="flex flex-col items-center gap-3"><div class="flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row sm:justify-center sm:gap-4"><a class="group inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-all h-[52px] px-7 text-base bg-[var(--accent)] text-white shadow-md shadow-[var(--accent)]/20 hover:brightness-105 keycap mb-[3px] w-full sm:mb-0 sm:w-auto" href="/en/onboarding"><span>Start my free trial</span><span class="transition-transform group-hover:translate-x-1">→</span></a><a href="#demo" class="keycap keycap-flat inline-flex h-[52px] w-full items-center justify-center gap-2 rounded-full border-[1.5px] border-[var(--near-black)] bg-white px-7 text-base font-semibold text-[var(--foreground)] sm:w-auto">Try it on your phone<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M216.49,104.49l-80,80a12,12,0,0,1-17,0l-80-80a12,12,0,0,1,17-17L128,159l71.51-71.52a12,12,0,0,1,17,17Z"></path></svg></a></div><p class="text-sm font-medium text-[var(--muted-foreground)]"><span>14 days free · Cancel anytime</span></p></div></div></section></div>"`;

exports[`what Platform's own pieces render when the previews' new props are left out (AC2) LpFaq: the five shared questions and the contact line 1`] = `"<section data-landing-section="faq" class="relative scroll-mt-24 py-16 lg:py-24  "><div class="mx-auto max-w-[840px] px-4 sm:px-6 lg:px-8 "><div data-sr="true" class="scroll-reveal "><div class="max-w-2xl  "><h2 class="text-h2 text-balance">Questions owners ask</h2></div></div><div data-sr="true" class="scroll-reveal mt-10 lg:mt-14" style="transition-delay:120ms"><div class="flex flex-col gap-5"><details class="group flex flex-col rounded-xl bg-white blog-card-3d px-6 py-4"><summary class="flex cursor-pointer items-center justify-between gap-6 py-2 list-none"><p class="text-lg font-bold leading-normal group-hover:text-[var(--accent)] transition-colors">Do my customers have to download an app?</p><div class="text-[var(--muted-foreground)] transition-transform duration-300 group-open:rotate-180 group-open:text-[var(--accent)]"><span class="text-xl font-bold">↓</span></div></summary><div class="pt-2 pb-4"><p class="text-[var(--muted-foreground)] text-base font-medium leading-relaxed"><span>No. Apple Wallet and Google Wallet are already on their phone. They scan your QR code and the card is in their wallet in seconds.</span></p></div></details><details class="group flex flex-col rounded-xl bg-white blog-card-3d px-6 py-4"><summary class="flex cursor-pointer items-center justify-between gap-6 py-2 list-none"><p class="text-lg font-bold leading-normal group-hover:text-[var(--accent)] transition-colors">Do I need new hardware or a new POS?</p><div class="text-[var(--muted-foreground)] transition-transform duration-300 group-open:rotate-180 group-open:text-[var(--accent)]"><span class="text-xl font-bold">↓</span></div></summary><div class="pt-2 pb-4"><p class="text-[var(--muted-foreground)] text-base font-medium leading-relaxed"><span>No. You stamp cards with our free app or from any phone&#x27;s browser. Nothing changes at your register, and there&#x27;s nothing to connect.</span></p></div></details><details class="group flex flex-col rounded-xl bg-white blog-card-3d px-6 py-4"><summary class="flex cursor-pointer items-center justify-between gap-6 py-2 list-none"><p class="text-lg font-bold leading-normal group-hover:text-[var(--accent)] transition-colors">How do customers join?</p><div class="text-[var(--muted-foreground)] transition-transform duration-300 group-open:rotate-180 group-open:text-[var(--accent)]"><span class="text-xl font-bold">↓</span></div></summary><div class="pt-2 pb-4"><p class="text-[var(--muted-foreground)] text-base font-medium leading-relaxed"><span>They scan the QR code at your counter, or tap the link you share online, and add the card to Apple Wallet or Google Wallet. Your dashboard prints a ready-made counter flyer.</span></p></div></details><details class="group flex flex-col rounded-xl bg-white blog-card-3d px-6 py-4"><summary class="flex cursor-pointer items-center justify-between gap-6 py-2 list-none"><p class="text-lg font-bold leading-normal group-hover:text-[var(--accent)] transition-colors">What happens when the free trial ends?</p><div class="text-[var(--muted-foreground)] transition-transform duration-300 group-open:rotate-180 group-open:text-[var(--accent)]"><span class="text-xl font-bold">↓</span></div></summary><div class="pt-2 pb-4"><p class="text-[var(--muted-foreground)] text-base font-medium leading-relaxed"><span>You choose whether to continue. We ask for your card to start the trial, and nothing is charged before the 14 days are up. Cancel anytime before then.</span></p></div></details><details class="group flex flex-col rounded-xl bg-white blog-card-3d px-6 py-4"><summary class="flex cursor-pointer items-center justify-between gap-6 py-2 list-none"><p class="text-lg font-bold leading-normal group-hover:text-[var(--accent)] transition-colors">Is there a contract?</p><div class="text-[var(--muted-foreground)] transition-transform duration-300 group-open:rotate-180 group-open:text-[var(--accent)]"><span class="text-xl font-bold">↓</span></div></summary><div class="pt-2 pb-4"><p class="text-[var(--muted-foreground)] text-base font-medium leading-relaxed"><span>No. Monthly plans have no contract and no setup fee. Cancel anytime from your dashboard.</span></p></div></details></div><p class="mt-8 text-base text-[var(--muted-foreground)]">Another question? <a class="inline-flex min-h-11 items-center font-semibold text-[var(--foreground)] underline underline-offset-4" href="/en/contact">Contact us</a>. We reply within 24 hours.</p></div></div></section>"`;

exports[`what Platform's own pieces render when the previews' new props are left out (AC2) DeliverAnalytics: the two tiles and the weekly chart 1`] = `"<div role="img" aria-label="Analytics: 2,770 visits, up 17%; a 30-day return rate of 61%, up 2 points; and the visits over time, week by week." class="grid grid-cols-2 gap-2.5"><div class="rounded-2xl bg-white p-3 ring-1 ring-black/[0.05] sm:p-3.5"><p class="truncate text-[11px] leading-4" style="color:#8a8a8a">Visits</p><div class="mt-1.5 flex items-baseline justify-between gap-2"><span class="text-[1.625rem] leading-none font-semibold tracking-[-0.03em] tabular-nums" style="color:#1a1a1a">2,770</span><span class="text-[11px] font-semibold tabular-nums" style="color:#2e9e5b">▲17%</span></div></div><div class="rounded-2xl bg-white p-3 ring-1 ring-black/[0.05] sm:p-3.5"><p class="truncate text-[11px] leading-4" style="color:#8a8a8a">30-day return rate</p><div class="mt-1.5 flex items-baseline justify-between gap-2"><span class="text-[1.625rem] leading-none font-semibold tracking-[-0.03em] tabular-nums" style="color:#1a1a1a">61%</span><span class="text-[11px] font-semibold tabular-nums" style="color:#2e9e5b">▲2 pts</span></div></div><div class="col-span-2 rounded-2xl bg-white p-3 ring-1 ring-black/[0.05] sm:p-3.5"><div class="flex items-center justify-between gap-2"><p class="text-[12px] leading-4 font-semibold" style="color:#1a1a1a">Visits over time</p><div class="flex gap-2.5 text-[10px] leading-4" style="color:#8a8a8a"><span class="flex items-center gap-1"><span class="h-2 w-2 rounded-[2px]" style="background-color:#0f172a"></span>Returning</span><span class="flex items-center gap-1"><span class="h-2 w-2 rounded-[2px]" style="background-color:#adbbdc"></span>First visit</span></div></div><div class="mt-3 flex h-[72px] items-end gap-[3%] border-b border-black/[0.07]"><div data-week="0" class="flex flex-1 flex-col" style="height:62.30769230769231%"><div class="rounded-t-[2px]" style="height:15.432098765432098%;backgro